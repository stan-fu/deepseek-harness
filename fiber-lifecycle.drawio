<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram id="fiber-lifecycle" name="Fiber Lifecycle">
    <mxGraphModel dx="1400" dy="960" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="start" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1C1C1E;strokeColor=#1C1C1E;" vertex="1" parent="1">
          <mxGeometry x="710" y="40" width="20" height="20" as="geometry" />
        </mxCell>

        <mxCell id="pending" value="PENDING&lt;br&gt;&lt;font style='font-size:10px'&gt;等待依赖 · 不跑 apply&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F7;strokeColor=#8E8E93;fontColor=#1C1C1E;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="640" y="100" width="160" height="60" as="geometry" />
        </mxCell>

        <mxCell id="loading" value="LOADING&lt;br&gt;&lt;font style='font-size:10px'&gt;apply 执行中&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1C1C1E;fontSize=13;fontStyle=1;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
          <mxGeometry x="640" y="280" width="160" height="60" as="geometry" />
        </mxCell>

        <mxCell id="failed" value="FAILED&lt;br&gt;&lt;font style='font-size:10px'&gt;apply / 校验抛错&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1C1C1E;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="280" width="160" height="60" as="geometry" />
        </mxCell>

        <mxCell id="active" value="ACTIVE&lt;br&gt;&lt;font style='font-size:10px'&gt;已加载 · 对外提供服务&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1C1C1E;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="640" y="460" width="160" height="60" as="geometry" />
        </mxCell>

        <mxCell id="unloading" value="UNLOADING&lt;br&gt;&lt;font style='font-size:10px'&gt;disposer 执行中&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1C1C1E;fontSize=13;fontStyle=1;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
          <mxGeometry x="640" y="640" width="160" height="60" as="geometry" />
        </mxCell>

        <mxCell id="disposed" value="DISPOSED&lt;br&gt;&lt;font style='font-size:10px'&gt;uid = null · 不可复活&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5E5EA;strokeColor=#8E8E93;fontColor=#1C1C1E;fontSize=13;fontStyle=1;dashed=1;dashPattern=8 8;" vertex="1" parent="1">
          <mxGeometry x="640" y="820" width="160" height="60" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="&lt;b&gt;稳定态：由字段派生&lt;/b&gt;&lt;br&gt;uid = null     → DISPOSED&lt;br&gt;_error 存在    → FAILED&lt;br&gt;epoch 有效     → ACTIVE&lt;br&gt;否则           → PENDING&lt;br&gt;&lt;br&gt;&lt;b&gt;过渡态：显式设置&lt;/b&gt;&lt;br&gt;LOADING    apply 执行中&lt;br&gt;UNLOADING  disposer 执行中&lt;br&gt;&lt;br&gt;&lt;b&gt;dispose()&lt;/b&gt; 可从任一状态进入&lt;br&gt;UNLOADING，清理完 → DISPOSED&lt;br&gt;inertia 保证同一时刻只有一&lt;br&gt;个迁移在飞，其余变化只记账" style="text;html=1;strokeColor=#D1D1D6;fillColor=#FFFFFF;align=left;verticalAlign=top;whiteSpace=wrap;spacing=8;fontSize=11;fontFamily=Menlo;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1000" y="40" width="300" height="250" as="geometry" />
        </mxCell>

        <mxCell id="note" value="&lt;b&gt;epoch 何时变化&lt;/b&gt;&lt;br&gt;提供方换成另一个 fiber → 变&lt;br&gt;服务出现 / 消失         → 变&lt;br&gt;提供方 ctx.set 改值     → 不变&lt;br&gt;check() 结果变化        → 不变&lt;br&gt;&lt;br&gt;epoch 只拼直接依赖的提供&lt;br&gt;方 uid，不含间接依赖；间接&lt;br&gt;依赖靠服务上下线逐级传导。" style="text;html=1;strokeColor=#D1D1D6;fillColor=#FFFFFF;align=left;verticalAlign=top;whiteSpace=wrap;spacing=8;fontSize=11;fontFamily=Menlo;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1000" y="460" width="300" height="170" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="创建" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=0;html=1;exitPerimeter=1;entryPerimeter=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=classic;endSize=6;strokeColor=#6B7280;strokeWidth=1.5;fontSize=11;fontColor=#3A3A3C;labelBackgroundColor=#FFFFFF;labelBorderColor=none;labelPadding=2;" edge="1" parent="1" source="start" target="pending">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="24" y="0" as="offset" />
          </mxGeometry>
        </mxCell>

        <mxCell id="e2" value="epoch 由空变有效" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=0;html=1;exitPerimeter=1;entryPerimeter=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=classic;endSize=6;strokeColor=#6B7280;strokeWidth=1.5;fontSize=11;fontColor=#3A3A3C;labelBackgroundColor=#FFFFFF;labelBorderColor=none;labelPadding=2;" edge="1" parent="1" source="pending" target="loading">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e3" value="apply 成功返回" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=0;html=1;exitPerimeter=1;entryPerimeter=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=classic;endSize=6;strokeColor=#6B7280;strokeWidth=1.5;fontSize=11;fontColor=#3A3A3C;labelBackgroundColor=#FFFFFF;labelBorderColor=none;labelPadding=2;" edge="1" parent="1" source="loading" target="active">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e4" value="epoch 变化" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=0;html=1;exitPerimeter=1;entryPerimeter=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=classic;endSize=6;strokeColor=#6B7280;strokeWidth=1.5;fontSize=11;fontColor=#3A3A3C;labelBackgroundColor=#FFFFFF;labelBorderColor=none;labelPadding=2;" edge="1" parent="1" source="active" target="unloading">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e5" value="dispose 完成" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=0;html=1;exitPerimeter=1;entryPerimeter=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=classic;endSize=6;strokeColor=#8E8E93;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontSize=11;fontColor=#3A3A3C;labelBackgroundColor=#FFFFFF;labelBorderColor=none;labelPadding=2;" edge="1" parent="1" source="unloading" target="disposed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e6" value="apply 抛错" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=0;html=1;exitPerimeter=1;entryPerimeter=1;exitX=0;exitY=0.25;entryX=1;entryY=0.25;endArrow=classic;endSize=6;strokeColor=#b85450;strokeWidth=1.5;fontSize=11;fontColor=#3A3A3C;labelBackgroundColor=#FFFFFF;labelBorderColor=none;labelPadding=2;" edge="1" parent="1" source="loading" target="failed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e7" value="依赖再次有效" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=0;html=1;exitPerimeter=1;entryPerimeter=1;exitX=1;exitY=0.75;entryX=0;entryY=0.75;endArrow=classic;endSize=6;strokeColor=#b85450;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontSize=11;fontColor=#3A3A3C;labelBackgroundColor=#FFFFFF;labelBorderColor=none;labelPadding=2;" edge="1" parent="1" source="failed" target="loading">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e8" value="期间 epoch 又变&lt;br&gt;（stale，跳过 apply）" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=0;html=1;exitPerimeter=1;entryPerimeter=1;exitX=1;exitY=0.25;entryX=1;entryY=0.8;endArrow=classic;endSize=6;strokeColor=#d79b00;strokeWidth=1.5;fontSize=11;fontColor=#3A3A3C;labelBackgroundColor=#FFFFFF;labelBorderColor=none;labelPadding=2;" edge="1" parent="1" source="loading" target="unloading">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="940" y="295" />
              <mxPoint x="940" y="688" />
            </Array>
            <mxPoint x="-120" y="-14" as="offset" />
          </mxGeometry>
        </mxCell>

        <mxCell id="e9" value="清理完&lt;br&gt;epoch 仍为空" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=0;html=1;exitPerimeter=1;entryPerimeter=1;exitX=0;exitY=0.25;entryX=0;entryY=0.5;endArrow=classic;endSize=6;strokeColor=#d79b00;strokeWidth=1.5;fontSize=11;fontColor=#3A3A3C;labelBackgroundColor=#FFFFFF;labelBorderColor=none;labelPadding=2;" edge="1" parent="1" source="unloading" target="pending">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="280" y="655" />
              <mxPoint x="280" y="130" />
            </Array>
            <mxPoint x="-46" y="0" as="offset" />
          </mxGeometry>
        </mxCell>

        <mxCell id="e10" value="清理完&lt;br&gt;epoch 已有效" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=0;html=1;exitPerimeter=1;entryPerimeter=1;exitX=1;exitY=0.2;entryX=1;entryY=0.8;endArrow=classic;endSize=6;strokeColor=#d79b00;strokeWidth=1.5;fontSize=11;fontColor=#3A3A3C;labelBackgroundColor=#FFFFFF;labelBorderColor=none;labelPadding=2;" edge="1" parent="1" source="unloading" target="loading">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="880" y="652" />
              <mxPoint x="880" y="328" />
            </Array>
            <mxPoint x="-94" y="0" as="offset" />
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
